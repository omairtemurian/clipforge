LLM_PROVIDER=copilot
GITHUB_COPILOT_TOKEN=
# Empty GITHUB_COPILOT_TOKEN: the token of this GitHub CLI account
COPILOT_ACCOUNT=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=claude-sonnet-5.5
OLLAMA_HOST=http://localhost:11434
# Ollama vision model for frame captions; empty: the first pulled vision model
VLM_MODEL=
# LLM_PROVIDER=anthropic: Anthropic API key and model id
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5-5
# LLM_PROVIDER=claude_code: the Claude Code program and model alias
CLAUDE_CODE_BIN=claude
CLAUDE_CODE_MODEL=sonnet
# DeepFilterNet engine: the deep-filter program (empty: models/deepfilternet,
# else deep-filter on PATH)
DEEP_FILTER_BIN=
# Piper voiceover engine: the piper program (empty: piper on PATH)
PIPER_BIN=
HF_TOKEN=
FFMPEG_BIN=
FFPROBE_BIN=
# libx264 or h264_videotoolbox; empty: h264_videotoolbox if ffmpeg has it
VIDEO_ENCODER=
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_FILE=
# v2: social platform apps, stock media, cloud import, email (SPEC-v2 3)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PEXELS_API_KEY=
PIXABAY_API_KEY=
FREESOUND_API_KEY=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# v2: fast creator watch (T28c): @handle lookup, Twitch go-live
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
